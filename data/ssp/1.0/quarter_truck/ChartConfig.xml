<?xml version="1.0" encoding="UTF-8"?>
<nova:ChartConfig xmlns:nova="http://github.com/Nova-platform/libnova/resources/schema/ChartConfig">

    <nova:chart>
        <nova:timeseries title="Quarter-truck" label="Height[m]">
            <nova:series>
                <nova:component name="chassis">
                    <nova:variable name="zChassis"/>
                </nova:component>
                <nova:component name="wheel">
                    <nova:variable name="zWheel"/>
                </nova:component>
                <nova:component name="ground">
                    <nova:variable name="zGround"/>
                </nova:component>
            </nova:series>
        </nova:timeseries>
    </nova:chart>

</nova:ChartConfig>
